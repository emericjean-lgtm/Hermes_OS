{
  "profile": "wsl",
  "debug": true,
  "database": {
    "backend": "sqlite"
  },
  "runtime": {
    "enable_gpu": false,
    "enable_cpu_fallback": true,
    "max_concurrent_tasks": 2,
    "memory_limit_mb": 2048,
    "cache_size_mb": 256
  },
  "monitoring": {
    "memory_threshold_mb": 4096,
    "cpu_threshold_pct": 70.0
  },
  "logging": {
    "level": "DEBUG",
    "json_format": false,
    "console_output": true,
    "file_output": true
  }
}
