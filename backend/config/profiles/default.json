{
  "profile": "local_gpu",
  "version": "1.0.0",
  "debug": false,
  "api_host": "0.0.0.0",
  "api_port": 8000,
  "frontend_url": "http://localhost:3000",
  "cors_origins": ["http://localhost:3000"],
  "workspace_dir": "workspace",
  "data_dir": "data",
  "database": {
    "backend": "sqlite",
    "host": "localhost",
    "port": 5432,
    "name": "hermes_os",
    "pool_size": 10,
    "max_overflow": 20,
    "echo": false,
    "ssl_mode": "prefer"
  },
  "redis": {
    "host": "localhost",
    "port": 6379,
    "db": 0,
    "socket_timeout_s": 5,
    "retry_on_timeout": true,
    "max_connections": 20
  },
  "vector": {
    "backend": "chromadb",
    "host": "localhost",
    "port": 8000,
    "collection": "hermes_embeddings",
    "dimension": 768
  },
  "security": {
    "token_expiry_h": 24,
    "max_login_attempts": 5,
    "lockout_minutes": 15,
    "enable_ssl": false
  },
  "monitoring": {
    "enabled": true,
    "metrics_port": 9090,
    "health_check_interval_s": 30,
    "alert_on_crash": true,
    "alert_on_high_memory": true,
    "memory_threshold_mb": 8192,
    "cpu_threshold_pct": 90.0,
    "recovery_attempts": 3,
    "recovery_cooldown_s": 60
  },
  "logging": {
    "level": "INFO",
    "json_format": true,
    "log_dir": "logs",
    "max_file_size_mb": 100,
    "backup_count": 10,
    "correlation_id": true,
    "console_output": true,
    "file_output": true
  },
  "runtime": {
    "mode": "local",
    "default_model": "llama3.2:3b",
    "max_concurrent_tasks": 4,
    "task_timeout_s": 300,
    "enable_gpu": true,
    "enable_cpu_fallback": true,
    "memory_limit_mb": 4096,
    "cache_size_mb": 1024
  }
}
