# Copy this file to .env and fill in real values before running Hermes.
# Never commit the real .env file.

# ── OLLAMA ──────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=10m

# ── BACKEND / FRONTEND ──────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change_me_with_a_random_256bit_key
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── MEMORY ───────────────────────────────────────────
CHROMA_PATH=./data/db/chroma
SQLITE_PATH=./data/db/hermes.db

# ── SECURITY ─────────────────────────────────────────
# Comma-separated whitelist of directories Hermes is allowed to read/write.
# Replace with your real project paths, e.g. /home/<user>/projects
ALLOWED_PATHS=/home/<user>/projects,/home/<user>/documents
MAX_FILE_SIZE_MB=50

# ── TELEGRAM (optional, leave empty to disable) ──────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── GPU MONITORING (RX 6800 / 16 GB) ─────────────────
GPU_VRAM_TOTAL_GB=16
GPU_ALERT_TEMP_C=85
GPU_CRITICAL_TEMP_C=90
GPU_VRAM_WARNING_PCT=85

# ── SELF-EVOLUTION (not active in the walking skeleton) ──
SKILL_AUTO_VALIDATE_THRESHOLD=0.95
SKILL_MIN_CONFIDENCE=0.30
REFLECTION_ENABLED=false
EBBINGHAUS_DECAY_ENABLED=false

# ── CONFIG FILE PATHS ────────────────────────────────
MODELS_CONFIG_PATH=./config/models.yaml
AGENTS_CONFIG_PATH=./config/agents.yaml
