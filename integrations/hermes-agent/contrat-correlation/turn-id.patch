diff --git a/tools/skill_provenance.py b/tools/skill_provenance.py
index 3df9cf1430..1ea54a3745 100644
--- a/tools/skill_provenance.py
+++ b/tools/skill_provenance.py
@@ -24,3 +24,38 @@ def get_current_write_origin() -> str:
 
 def is_background_review() -> bool:
     return get_current_write_origin() == BACKGROUND_REVIEW
+
+
+# --- Client turn correlation -------------------------------------------------
+# An OPAQUE identifier the ACP client may attach to one prompt via
+# ``_meta.hermes.turnId`` (the `_meta` field ACP reserves for extensions). It is
+# echoed back, unchanged, in every ``on_skill_lifecycle`` event of that turn so
+# the client can attribute skill mutations to the unit of work IT knows about.
+#
+# Deliberately NOT ``task_id`` or ``session_id``: on the ACP path both are the
+# session id (``run_conversation(..., task_id=session_id)``), so neither is
+# turn-granular, and both are the agent's identities rather than the client's.
+#
+# Never generated here. Absent in means absent out: an unset turn id is "",
+# and ``_emit_skill_lifecycle`` then omits the key entirely rather than
+# inventing a default that a consumer could mistake for a real correlation.
+_turn_correlation: contextvars.ContextVar[str] = contextvars.ContextVar(
+    "skill_client_turn_id", default="")
+
+
+def set_current_turn_id(turn_id: str) -> contextvars.Token[str]:
+    """Bind the client-supplied turn id for the duration of one turn.
+
+    Bound where the turn body runs, so it inherits the per-turn
+    ``contextvars.copy_context()`` that already isolates concurrent sessions.
+    """
+    return _turn_correlation.set(str(turn_id or ""))
+
+
+def reset_current_turn_id(token: contextvars.Token[str]) -> None:
+    _turn_correlation.reset(token)
+
+
+def get_current_turn_id() -> str:
+    """The client turn id for this turn, or "" when the client supplied none."""
+    return _turn_correlation.get()
