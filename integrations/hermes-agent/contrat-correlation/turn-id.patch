+def _client_turn_id(kwargs: dict[str, Any]) -> str:
+    """The opaque turn id the client attached to this prompt, or "".
+
+    ACP reserves ``_meta`` for extensions ("Implementations MUST NOT make
+    assumptions about values at these keys"), and the router spreads its
+    top-level keys into the handler's ``**kwargs``. A client that sends
+    ``_meta: {"hermes": {"turnId": "..."}}`` therefore arrives here as
+    ``kwargs["hermes"]["turnId"]`` — the same ``_meta.hermes`` namespace this
+    adapter already uses outbound for session provenance.
+
+    Never generated, never validated, never defaulted: the value is opaque to
+    the agent, which only carries it and hands it back. Anything that is not a
+    non-empty string is treated as absent, because a client that sent junk did
+    not send a correlation.
+    """
+    extension = kwargs.get("hermes")
+    if not isinstance(extension, dict):
+        return ""
+    turn_id = extension.get("turnId")
+    return turn_id.strip() if isinstance(turn_id, str) else ""
+
