# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets / local config
.env

# Node / frontend
frontend/node_modules/
frontend/.next/
frontend/out/

# Runtime data (SQLite, ChromaDB, logs, snapshots)
data/db/*
data/logs/*
data/snapshots/*
# Base du bus d'événements : état d'exécution, pas du code source.
data/eventbus/
!data/db/.gitkeep
!data/logs/.gitkeep
!data/snapshots/.gitkeep

# Diagnostic capture logs (scripts/capture_proxy.py output)
scripts/capture_log.jsonl

# Workflow output (the new-app workflow's default files_apply target —
# generated app code belongs in its own repo, not this one)
data/generated/

# OS
.DS_Store
