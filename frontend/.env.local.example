# Base URL of the Hermes API, including the /api/v1 prefix.
#
# The prefix matters: services/client.ts calls fetchJSON("/agents"), so this
# value must already end in /api/v1. Without it every Cockpit request lands on
# an unprefixed path (/agents instead of /api/v1/agents) and fails.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# WebSocket endpoint for the live event feed.
NEXT_PUBLIC_WS_URL=ws://localhost:8000
