# pnpm 10+ enables a "minimum release age" supply-chain policy by default,
# rejecting any resolved package published within the last ~24h. That's a
# reasonable default for CI/production pipelines, but it makes local dev
# installs flaky for no benefit on a personal single-developer machine
# (see https://github.com/pnpm/pnpm/issues/10438 for why regenerating the
# lockfile doesn't reliably fix it either). Disabled here on purpose.
minimum-release-age=0
